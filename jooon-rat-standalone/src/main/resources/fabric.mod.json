  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": ">=1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.1+1.21.11",
    "fabric-language-kotlin": ">=1.10.20+kotlin.1.9.24"
